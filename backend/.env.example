# Copy to backend/.env and adjust for your machine.

# Required for every database-backed endpoint. Without it the API starts but
# /ready and all data routes fail.
# - installed PostgreSQL service on this machine: port 5432
# - the `db` container from docker-compose.dev.yml: port 5433
DATABASE_URL=postgresql://stakr:stakr@localhost:5432/stakr

# JWT signing key. Generate a real one for anything other than local dev.
SECRET_KEY=dev-secret-key-change-me

# Comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:5173 when left empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fail fast on health checks when the database is unreachable.
DB_CONNECT_TIMEOUT_SECONDS=5

# Apply Alembic migrations and seed reference data on start. Production leaves
# this unset and applies them once per deploy instead, to keep them off the
# container's cold-start path.
RUN_MIGRATIONS=0
