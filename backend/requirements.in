# Direct runtime dependencies. THIS is the file you edit.
#
# requirements.txt is generated from it and is a full lock: every transitive
# package pinned and hashed. Regenerate after any change here:
#
#   docker run --rm -v "${PWD}/backend:/w" -w /w python:3.12-slim \
#     sh -c "pip install -q uv && uv pip compile requirements.in \
#            --universal --generate-hashes -o requirements.txt"
#
# It is compiled in a Linux container so the resolution matches the runtime
# image, and --universal keeps it installable on Windows for local dev.
#
# Note: `fastapi[standard]` is deliberately NOT used. It pulls fastapi-cli,
# rich and typer, none of which are imported at runtime -- they only bloat the
# image and the cold-start import graph. Test-only extras (httpx, needed by
# TestClient) live in dev-requirements.in.

# --- Web framework / ASGI server ---
fastapi==0.141.1
uvicorn==0.52.1
# C HTTP parser; uvicorn auto-detects it and falls back to its pure-Python
# parser when absent.
httptools==0.8.0
# Faster event loop. Linux/macOS only: it has no Windows wheels, and local
# development on Windows must still be able to install this file.
uvloop>=0.21,<1.0; sys_platform != "win32"

