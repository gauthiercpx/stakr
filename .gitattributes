# Normalize text files in the repository to LF.
* text=auto

# Files consumed by Linux tooling must keep LF in the working copy too.
# On Windows, core.autocrlf=true would otherwise check these out with CRLF,
# and `docker build` bakes them into the image — the container then fails with
# `env: 'sh\r': No such file or directory` (exit 127).
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
